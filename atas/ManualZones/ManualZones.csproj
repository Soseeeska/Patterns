<Project Sdk="Microsoft.NET.Sdk">
  <!-- Индикатор для ATAS X (кроссплатформенная сборка, как Platform=Cross в AtasPlatform/Indicators).
       Сборка:  dotnet build -c Release -p:ATAS_BASE="C:\Program Files\ATAS X"
       ATAS_BASE — папка с ATAS.Indicators.dll, OFT.Rendering.dll, ATAS.DataFeedsCore.dll, Utils.Common.dll
       (на macOS: "/Applications/ATAS X.app/Contents/MonoBundle"). Проверка компиляции без ATAS: -p:Stubs=true. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ManualZones</AssemblyName>
    <RootNamespace>Patterns.Atas</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);CROSS_PLATFORM</DefineConstants>
    <ATAS_BASE Condition=" '$(ATAS_BASE)' == '' ">C:\Program Files\ATAS X</ATAS_BASE>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition=" '$(Stubs)' != 'true' ">
    <Reference Include="ATAS.Indicators"><HintPath>$(ATAS_BASE)\ATAS.Indicators.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="ATAS.DataFeedsCore"><HintPath>$(ATAS_BASE)\ATAS.DataFeedsCore.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OFT.Rendering"><HintPath>$(ATAS_BASE)\OFT.Rendering.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(ATAS_BASE)\Utils.Common.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OFT.Attributes" Condition="Exists('$(ATAS_BASE)\OFT.Attributes.dll')"><HintPath>$(ATAS_BASE)\OFT.Attributes.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition=" '$(Stubs)' == 'true' ">
    <ProjectReference Include="..\stubs\AtasStubs.csproj" Private="false" />
  </ItemGroup>
</Project>
