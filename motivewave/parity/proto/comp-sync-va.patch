+    public static List<int[]> compNodes(Comp c, Params p) {
+        if (c.cnodes != null) return c.cnodes;
+        double dip = Double.parseDouble(System.getProperty("syncDip", "0.15")), drop = Double.parseDouble(System.getProperty("syncDrop", "0.25"));
+        Profile pf = c.prof; int[] cnt = pf.counts; int n = cnt.length, onePt = (int) Math.round(1.0 / p.tick), half = onePt / 2;
+        double[] sm = new double[n];
+        for (int i = 0; i < n; i++) { double sum = 0; int k = 0; for (int j = Math.max(0, i - half); j <= Math.min(n - 1, i + half); j++) { sum += cnt[j]; k++; } sm[i] = sum / k; }
+        double mx = 0; for (double v : sm) mx = Math.max(mx, v);
+        int pi = c.pocT - pf.low, a = pi, b = pi;
+        while (a > 0 && sm[a - 1] >= p.bodyShare * mx) a--;
